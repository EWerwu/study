MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"孙少安"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"公社"}) MERGE (a)-[r:`任职于` {sid:"2.02"}]->(b) SET r.evidence="头脑灵活的少安又进城拉砖，用赚的钱建窑烧砖（大部分为贷款），成了公社的“冒尖户”。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"田晓霞"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"省报"}) MERGE (a)-[r:`任职于` {sid:"2.03"}]->(b) SET r.evidence="少平青春的梦想和追求也激励着他到外面去“闯荡世界”，他从漂泊的揽工汉成为正式的建筑工人，最后又获得了当煤矿工人的好机遇，他的女友晓霞从师专毕业后到省报当了记者，他们相约两年后再相会。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"田晓霞"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"师专"}) MERGE (a)-[r:`毕业于` {sid:"2.03"}]->(b) SET r.evidence="少平青春的梦想和追求也激励着他到外面去“闯荡世界”，他从漂泊的揽工汉成为正式的建筑工人，最后又获得了当煤矿工人的好机遇，他的女友晓霞从师专毕业后到省报当了记者，他们相约两年后再相会。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"田润叶"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"团地委"}) MERGE (a)-[r:`到访` {sid:"2.04"}]->(b) SET r.evidence="润叶远离她不爱的丈夫到团地委工作，引起钟情痴心的丈夫酒后开车致残，润叶感到内疚回到丈夫身边，开始幸福生活。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"孙少平"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"煤矿"}) MERGE (a)-[r:`就业机会` {sid:"3.01"}]->(b) SET r.evidence="1982年孙少平到了煤矿，尽心尽力干活，从学生成了一名优秀工人。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"孙少平"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"田晓霞"}) MERGE (a)-[r:`恋爱` {sid:"3.02"}]->(b) SET r.evidence="可是，就在孙少平与田晓霞产生强烈感情的时候，田晓霞却因在抗洪采访中为抢救灾民光荣牺牲了，后来田福军给孙少平发了封电报，少平悲痛不已。";
