MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"孙少安"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"秀莲"}) MERGE (a)-[r:`配偶` {sid:"1.06"}]->(b) SET r.evidence="经过痛苦的煎熬，少安到山西与勤劳善良的秀莲相亲并结了婚，润叶也只得含泪与父亲介绍的一直对她有爱慕之情的李向前结婚。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"李向前"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"田润叶"}) MERGE (a)-[r:`配偶` {sid:"1.06"}]->(b) SET r.evidence="经过痛苦的煎熬，少安到山西与勤劳善良的秀莲相亲并结了婚，润叶也只得含泪与父亲介绍的一直对她有爱慕之情的李向前结婚。";
MATCH (a:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"孙少安"}), (b:NovelCourseEntity {scope:"novel-course-qwen-2ccc6d96f5c60bf2",name:"责任制"}) MERGE (a)-[r:`推行` {sid:"2.01"}]->(b) SET r.evidence="1979年春，十一届三中全会后百废待兴又矛盾重重，田福堂连夜召开支部会抵制责任制，孙少安却领导生产队率先实行，接着也就在全村推广了责任制。";
